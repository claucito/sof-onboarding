# Clave compartida API ↔ panel (PoC; en producción usar proxy u otro mecanismo).
DEMO_API_KEY=cambiar-por-secreto-largo

# Puerto HTTP
PORT=3333

# SQLite (ruta relativa al cwd al arrancar)
DATABASE_PATH=./data/demo.sqlite

# Orígenes CORS permitidos, separados por coma, o vacío para reflejar el Origin (dev).
# Ejemplo producción: https://app.tudominio.com
CORS_ORIGIN=
