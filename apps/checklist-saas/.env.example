# SQLite (MVP local / CI). Copia a `.env` en esta carpeta.
DATABASE_URL="file:./prisma/dev.db"

# Firma de sesiones JWT (cookie httpOnly). Mínimo 32 caracteres; en prod usa un secreto aleatorio fuerte.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Postgres gestionado (ej. Neon, Supabase) — sustituye la URL y ejecuta `npx prisma migrate dev`:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
