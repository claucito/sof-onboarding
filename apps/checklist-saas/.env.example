# Postgres (preview/prod y local recomendado). Copia a `.env` en esta carpeta.
# Ejemplo local con Docker: `docker run --name pg-checklist -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=checklist -p 5432:5432 -d postgres:16-alpine`
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/checklist?schema=public"

# Firma de sesiones JWT (cookie httpOnly). Mínimo 32 caracteres; en prod usa un secreto aleatorio fuerte.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
