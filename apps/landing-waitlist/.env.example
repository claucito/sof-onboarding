# URL del proveedor de formularios (Formspree, Getform, Basin, etc.). Debe estar definida en build estático.
# Formspree: crea un formulario en https://formspree.io y usa la URL tipo https://formspree.io/f/xxxxxxxx
PUBLIC_WAITLIST_FORM_ACTION=

# Dominio público del sitio (sin barra final). Se usa en astro.config para `site`, redirección post-envío (_next) y URLs canónicas.
# Preview: https://tu-app.netlify.app  |  Producción: https://www.tudominio.com
PUBLIC_SITE_URL=https://preview.example.com

# Asunto opcional en el correo que recibe el proveedor (Formspree: campo _subject).
# PUBLIC_WAITLIST_FORM_SUBJECT=Nuevo lead — lista de espera
