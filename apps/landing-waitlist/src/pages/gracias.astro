---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Gracias — lista de espera" description="Confirmación de alta en la lista de espera.">
  <main id="contenido" class="wrap">
    <p class="eyebrow">Listo</p>
    <h1>Gracias por apuntarte</h1>
    <p class="lede">
      Te avisaremos cuando abramos plazas. Revisa tu correo por si necesitas confirmar el alta.
    </p>
    <div class="card">
      <a class="btn btn-secondary" href="/">Volver al inicio</a>
    </div>
  </main>
</Layout>
